# Git attributes for language detection
# Exclude generated HTML files and documentation from language statistics
*.html linguist-generated=true
docs/**/*.html linguist-documentation=true
outputs/**/*.html linguist-generated=true
Assets/**/*.html linguist-generated=true

# Ensure Python files are properly detected
*.py linguist-language=Python
*.ipynb linguist-language=Jupyter_Notebook

# Exclude large binary files from language detection
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Markdown files should be considered documentation
*.md linguist-documentation=true