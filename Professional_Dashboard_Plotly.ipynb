>                         'Category': category,
>                         'Cause': cause,
>                         'Site': site,
>                         'Month': month,
>                         'Year': year,
>                         'Severity': severity,
>                         'Status': stat,
>                         'Count': count
>                     })
> 
> df = pd.DataFrame(records)
